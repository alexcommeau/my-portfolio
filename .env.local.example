# URL privée du backend NestJS. En développement local : http://127.0.0.1:3001.
# Avec un tunnel vers le k8 : http://127.0.0.1:3002.
KNOWLEDGE_API_BASE_URL=http://127.0.0.1:3001

# Même clé de service que KNOWLEDGE_CHAT_KEY dans le runtime NestJS.
KNOWLEDGE_CHAT_KEY=

# Temps maximal accordé à la chaîne retrieval + génération.
KNOWLEDGE_API_TIMEOUT_MS=90000

# Facultatif. Le quota est désactivé par défaut en développement/test et actif
# par défaut en production. Utiliser false pour une build de test lancée avec
# `next start`, qui définit NODE_ENV=production.
KNOWLEDGE_CHAT_RATE_LIMIT_ENABLED=false

RESEND_API_KEY=
CONTACT_TO_EMAIL=
